# Docker 部署配置（复制为 .env）
POJUN_TAG=latest
# 镜像名：默认 ghcr.io/chu0119/pojun（amd64/arm64 双架构，CI 随版本发布）
# POJUN_IMAGE=ghcr.io/chu0119/pojun
POSTGRES_USER=pojun
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=pojun

# 控制台宿主侧发布地址（仅 Docker/compose 生效）：默认 127.0.0.1（仅本机）
# 局域网直连需显式改为 0.0.0.0（不推荐；优先 HTTPS 反向代理）
# POJUN_BIND_IP=127.0.0.1

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
POJUN_LLM_PROVIDER=
POJUN_LLM_MODEL=
POJUN_LLM_BASE_URL=
POJUN_LLM_PROXY=

# 更新专用代理：只作用于版本检查 / 整包下载 / hostd 跟随升级，不改变目标流量出口。
# 留空（默认）= 按「装机代理 → 全局代理 → 直连」回退；也可在「系统 → 设置 → 版本与更新」
# 里保存（页面设置优先于本环境变量）。
# POJUN_UPDATE_PROXY=http://127.0.0.1:7890
